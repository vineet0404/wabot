# Is file ko server par .env.production naam se copy karo aur saari values bharo.
# Secrets banane ke liye: python scripts/gen_secrets.py
# .env.production ko kabhi git me mat daalo, kabhi kisi ko mat bhejo.

DOMAIN=bot.aapkadomain.in
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=bot.aapkadomain.in
DJANGO_SECRET_KEY=
FIELD_ENCRYPTION_KEY=
# Random rakho, jaise panel-x7k2m9/
ADMIN_URL=
# Caddy ke peeche ho, isliye 1
TRUST_PROXY_HEADERS=1

POSTGRES_DB=wabot
POSTGRES_USER=wabot
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432
REDIS_URL=redis://redis:6379/0

META_APP_SECRET=
META_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0

# --- AI ---
LLM_PROVIDER=fake
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
LLM_TIMEOUT=60
LLM_DAILY_TOKEN_BUDGET=100000

# --- Knowledge base search (none = keyword; behtar search ke liye embedding lagao) ---
EMBED_PROVIDER=none
EMBED_MODEL=
EMBED_API_KEY=
EMBED_BASE_URL=

# --- Owner notification aur reminders ---
PUBLIC_BASE_URL=https://bot.aapkadomain.in
TELEGRAM_BOT_TOKEN=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
