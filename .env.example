# Is file ko .env naam se copy karo: cp .env.example .env
# .env ko kabhi git me mat daalo.

DJANGO_SECRET_KEY=dev-only-change-me
DJANGO_DEBUG=1

# Koi bhi database lagana ho to DATABASE_URL bharo (neeche POSTGRES_* ko tab ignore kiya jata hai):
#   postgres://user:pass@host:5432/dbname
#   mysql://user:pass@host:3306/dbname      (requirements-mysql.txt chahiye, docs/DATABASE.md dekho)
#   sqlite:///db.sqlite3
# DATABASE_URL=
POSTGRES_DB=wabot
POSTGRES_USER=wabot
POSTGRES_PASSWORD=wabot
POSTGRES_HOST=db
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/0

# Meta for Developers, App settings, Basic, App secret
META_APP_SECRET=
# Koi bhi lamba random string. Wahi string Meta ke webhook setup me bhi daalni hai.
META_VERIFY_TOKEN=change-me-to-a-random-string
# Meta dashboard me jo current Graph API version dikhe wahi daalo
WHATSAPP_API_VERSION=v21.0

# --- Security ---
# Token encrypt karne ki key. Banao: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Ek baar set karke badalna mat, warna purane saved tokens padhe nahi jayenge. Isko safe jagah backup rakho.
FIELD_ENCRYPTION_KEY=
# Admin ka raasta. Kuch random rakho, jaise panel-x7k2/  (default: admin/)
ADMIN_URL=admin/
# Tunnel ya proxy use kar rahe ho to 1 rakho (asli IP padhne ke liye)
TRUST_PROXY_HEADERS=1

# --- AI provider (details: docs/AI_PROVIDERS.md) ---
# fake = bina key ke testing (echo). Asli AI ke liye: claude, openai, groq, together, openrouter, gemini, ollama
LLM_PROVIDER=fake
LLM_API_KEY=
LLM_MODEL=
# Sirf tab bharo jab provider ka URL alag ho (preset ho to khali chhodo)
LLM_BASE_URL=
# Har business ke liye roz ke kul tokens. 0 = koi limit nahi
LLM_DAILY_TOKEN_BUDGET=100000

# Apna khud ka model chalana ho to docs/SELF_HOSTED_LLM.md dekho. Example:
# LLM_PROVIDER=local
# LLM_MODEL=qwen2.5:3b
# LLM_TIMEOUT=120

# --- Knowledge base search (docs/GO_LIVE.md) ---
# none = keyword search (bina API ke chalta hai). Behtar search ke liye embedding lagao, jaise:
# EMBED_PROVIDER=ollama
# EMBED_MODEL=nomic-embed-text     (pehle: ollama pull nomic-embed-text)
EMBED_PROVIDER=none
EMBED_MODEL=
EMBED_API_KEY=
EMBED_BASE_URL=

# --- Owner notification, booking, reminders (docs/BOOKING_AND_REMINDERS.md) ---
# Inbox ke links is address se bante hain
PUBLIC_BASE_URL=http://localhost:8000
# Telegram: @BotFather se bot banao, token yahan (khali = Telegram band)
TELEGRAM_BOT_TOKEN=
# Email (khali chhodo to dev me sandesh sirf logs me dikhta hai)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
